# --- LLM (OpenAI-compatible) -------------------------------------------------
# Swap OPENAI_BASE_URL to a local vLLM / Ollama endpoint to run fully offline.
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5-mini
LLM_TEMPERATURE=0.2

# --- Embeddings --------------------------------------------------------------
# local  -> sentence-transformers, runs on CPU now / CUDA when available
# openai -> text-embedding-3-small via the API (no local download)
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DEVICE=auto

# --- Retrieval ---------------------------------------------------------------
KNOWLEDGE_BASE_PATH=knowledge_base.txt
RETRIEVAL_TOP_K=4
RRF_K=60

# --- Server ------------------------------------------------------------------
HOST=0.0.0.0
PORT=8100
CHAT_DB_PATH=chat_history.db
